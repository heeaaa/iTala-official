# iTala — Supabase configuration (optional)
#
# Copy this file to `.env` and fill in values from your Supabase project
# (Dashboard → Project Settings → API). With both values set, the app runs in
# SYNCED mode. With either missing, it runs in LOCAL-ONLY mode (single device).
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle by Metro, so they're safe
# to put here for local development. The ANON key is safe to ship in the client
# binary — row-level security on the database is what actually protects writes.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Emergency admin password for LOCAL-ONLY builds (no Supabase project). Leave
# blank in synced builds: there the password is verified server-side against a
# bcrypt hash, with attempt throttling, and is never present in the app at all.
#
# Blank = the local password path is closed, which is the safe default. Anything
# set here is inlined into the JS bundle and readable by anyone who unpacks the
# app, so treat it as a UI lock rather than a secret, and never commit a value.
EXPO_PUBLIC_ADMIN_LOCAL_PASSWORD=
