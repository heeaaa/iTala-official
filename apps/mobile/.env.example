# Copy this file to apps/mobile/.env and fill in the two values.
#
# IMPORTANT: it must live in apps/mobile, NOT the repository root. Expo reads
# .env from the directory you run `expo start` in.
#
# .env is gitignored and must stay that way. The anon key is PUBLIC by design
# (it ships inside the binary and row-level security is what protects writes),
# but the service_role key must never appear here or anywhere in this repo.
#
# With either value missing the app runs local-only: no sync, no spectators,
# no realtime. The league settings screen will say so.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
