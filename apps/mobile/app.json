    "android": {
      "package": "com.bpbl.itala",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18202E"
      }
    },
    "extra": { "eas": { "projectId": "bf4508b7-20f9-4342-a315-9b6f6121aef9" } }
  }
}
