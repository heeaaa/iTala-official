{
  "name": "@itala/mobile",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "start:tunnel": "expo start --dev-client --tunnel",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.1",
    "@expo-google-fonts/oswald": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@itala/domain": "workspace:*",
    "@itala/sync": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^56.0.0",
    "expo-dev-client": "^6.0.0",
    "expo-font": "^14.0.0",
    "expo-sqlite": "^16.0.0",
    "expo-status-bar": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
