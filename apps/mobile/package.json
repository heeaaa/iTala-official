{
  "name": "@itala/mobile",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo start --android",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "bundle:check": "expo export --platform ios --platform android --output-dir .expo-export-check",
    "expo:doctor": "expo-doctor",
    "ios": "expo start --ios",
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.1",
    "@expo-google-fonts/oswald": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@itala/domain": "workspace:*",
    "@itala/sync": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^57.0.14",
    "expo-dev-client": "^57.0.13",
    "expo-font": "^57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo-doctor": "^1.20.2",
    "typescript": "6.0.3"
  }
}
