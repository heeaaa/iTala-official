{
  "expo": {
    "name": "iTala",
    "slug": "itala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "itala",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F18"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bpbl.itala",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.bpbl.itala",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F18"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "iTala lets you choose a photo from your library to use as a team logo.",
          "//": "Do not remove the two false flags below. This plugin adds RECORD_AUDIO and CAMERA to the Android manifest for video capture the app never does (it only calls launchImageLibraryAsync with Images). false omits AND blocks them; deleting them from android.permissions does not work. See DEPLOYMENT.md gotcha #2.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#12D7D0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bf4508b7-20f9-4342-a315-9b6f6121aef9"
      }
    }
  }
}
