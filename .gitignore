node_modules/
.expo/
dist/
*.log
.DS_Store
.env
.env.local
.env.*.local
# Claude Code. The agent definitions, workflows, shared context and validators
# are project tooling and belong to everyone working on this repo. Everything
# else under .claude/ remains local session state (this directory was
# blanket-ignored during the secrets scrub, which caught the tooling by
# accident rather than by intent).
.claude/*
!.claude/README.md
!.claude/PROJECT-CONTEXT.md
!.claude/agents/
!.claude/commands/
!.claude/scripts/
!.claude/validation/
!.claude/settings.json

# Mobile signing / service-account credentials - never commit these
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
play-service-account.json
google-services.json
GoogleService-Info.plist
