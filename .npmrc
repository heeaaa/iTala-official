# React Native and Expo resolve native modules by walking node_modules, and
# many of Expo's own packages depend on transitive modules (expo-modules-core
# among them) that pnpm's default isolated layout hides from Metro. Bundling
# fails with "Unable to resolve module expo-modules-core".
#
# A hoisted linker gives the flat node_modules that the React Native toolchain
# expects, at the cost of pnpm's strictness about undeclared dependencies. This
# is what Expo recommends for pnpm monorepos, and it is the difference between
# the app building and not.
node-linker=hoisted

auto-install-peers=true
strict-peer-dependencies=false
